# Copia este archivo a .env y cambia los valores. .env NUNCA se sube al repositorio.
# DATABASE_URL y S3_ENDPOINT no van aquí: los pone docker-compose.yml, porque dentro de
# Docker la base se llama `db` y el almacén se llama `almacen`.
JWT_SECRET=cambia-esto-por-48-bytes-al-azar
CODIGO_PROFESOR=cambia-este-codigo
ACCESS_TTL_S=300
REFRESH_TTL_S=604800

# Las llaves del almacén de objetos. Las usan los DOS lados: RustFS las toma como su
# usuario administrador y la API las usa para entrar. También son el usuario y la
# contraseña de la consola web (http://localhost:9001).
S3_ACCESS_KEY=avisos-admin
S3_SECRET_KEY=cambia-esto-por-otra-clave-larga
